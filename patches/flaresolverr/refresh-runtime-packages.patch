diff --git a/Dockerfile b/Dockerfile
--- a/Dockerfile
+++ b/Dockerfile
@@ -29,5 +29,6 @@ RUN dpkg -i /libgl1-mesa-dri.deb
     && dpkg -i /adwaita-icon-theme.deb \
     # Install dependencies
     && apt-get update \
+    && apt-get upgrade -y --no-install-recommends \
     && apt-get install -y --no-install-recommends chromium chromium-common chromium-driver xvfb dumb-init \
         procps curl vim xauth \
@@ -48,5 +49,9 @@ VOLUME /config
 # Install Python dependencies
 COPY requirements.txt .
-RUN pip install -r requirements.txt \
+# Refresh setuptools too: jaraco.context and wheel are also vendored there.
+# Installing standalone jaraco.context would leave the vulnerable vendor copy.
+RUN python -m pip install --no-cache-dir --upgrade setuptools==84.0.0 wheel==0.46.3 \
+    && python -m pip install --no-cache-dir -r requirements.txt \
+    && python -m pip check \
     # Remove temporary files
     && rm -rf /root/.cache
